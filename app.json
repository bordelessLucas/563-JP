{
  "expo": {
    "name": "563-JP",
    "slug": "563-joao-paulo-",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jp563",
    "userInterfaceStyle": "light",
    "owner": "borderlesspc12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.borderless.jp563"
    },
    "android": {
      "package": "com.borderless.jp563",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8b188305-c59e-4868-942e-9c2104761cf4"
      }
    }
  }
}
