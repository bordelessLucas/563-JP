# Client (Expo) — public Firebase web config only
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=jp-6a9d2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Checkout DEMO (mock) — padrão para APK de validação com o cliente
# Docs: docs/DEPLOY_MOCK.md  |  Reverter para real: docs/DEPLOY_REAL.md
# ---------------------------------------------------------------------------
# APP_ENV: development | test | staging | production
# Unset APP_ENV is treated as production for dangerous features (fail-closed).
APP_ENV=development
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock
# Must be explicitly true to allow simulateMockPayment (also blocked in production).
ENABLE_MOCK_PAYMENT=true
UBER_DIRECT_MODE=test
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CUSTOMER_ID=

# Para sair do mock (quando o cliente aprovar o fluxo):
#   1) Implementar gateway (MP/Asaas) + Uber Direct conforme docs/DEPLOY_REAL.md
#   2) Trocar params nas Cloud Functions:
#        APP_ENV=production          (ou staging antes)
#        PAYMENT_PROVIDER=mercadopago|asaas
#        DELIVERY_PROVIDER=uber_direct
#        ENABLE_MOCK_PAYMENT=false
#   3) Setar secrets Uber no Secret Manager
#   4) Redeploy functions — o APK só precisa rebuild se mudar EXPO_PUBLIC_*

# Store pickup (also configurable in Firestore settings/store)
STORE_NAME=Chuva de Ouro
STORE_PHONE=+5551999999999
STORE_STREET=Rua Exemplo
STORE_NUMBER=100
STORE_COMPLEMENT=
STORE_NEIGHBORHOOD=Centro
STORE_CITY=Porto Alegre
STORE_STATE=RS
STORE_CEP=90000000
STORE_COUNTRY=BR
STORE_LATITUDE=-30.0346
STORE_LONGITUDE=-51.2177

# SECRETS — never put real values here or in EXPO_PUBLIC_*.
# Set via Firebase Secret Manager:
#   firebase functions:secrets:set UBER_DIRECT_CLIENT_SECRET
#   firebase functions:secrets:set UBER_DIRECT_WEBHOOK_SIGNING_KEY
# Local emulator / vitest may use process.env for the same names.
# UBER_DIRECT_CLIENT_SECRET=
# UBER_DIRECT_WEBHOOK_SIGNING_KEY=
# Future (when implemented):
# ASAAS_API_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
