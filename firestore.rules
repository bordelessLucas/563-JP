rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'client';
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /carts/{userId} {
      // Owner may write cart, but cannot invent/alter server deliveryQuote.
      // Quotes are written only by Cloud Functions (Admin SDK).
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && cartCreateWithoutQuote();
      allow delete: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) || isAdmin())
        && cartDeliveryQuoteProtected();
    }

    // Client create must not seed a forged deliveryQuote.
    function cartCreateWithoutQuote() {
      let checkout = request.resource.data.get('checkout', null);
      return checkout == null
        || checkout.get('deliveryQuote', null) == null;
    }

    // Client may clear quote or keep the existing server quote unchanged.
    // Inventing a quote when none exists (or changing fee) is denied.
    function cartDeliveryQuoteProtected() {
      let oldQuote = resource.data.get('checkout', {}).get('deliveryQuote', null);
      let newCheckout = request.resource.data.get('checkout', null);
      let newQuote = newCheckout == null
        ? null
        : newCheckout.get('deliveryQuote', null);
      return newQuote == null || newQuote == oldQuote;
    }

    match /addresses/{addressId} {
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Orders: client/admin SDK cannot mutate. All writes via Cloud Functions (Admin SDK).
    match /orders/{orderId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == request.auth.uid);
      allow write: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == request.auth.uid);
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
